# Copy file này thành backend/.env rồi điền key. KHÔNG commit file .env.
# Chỉ gửi dữ liệu TỰ SINH lên API bên ngoài — không dùng chat thật của tổ chức.
OPENAI_API_KEY=
# Model bộ trích (cần json_schema strict); model tham chiếu v6 = gpt-4o-mini. Chạy `python -m detect.llm probe` trước.
EXTRACT_MODEL=gpt-4o-mini
# Tuỳ chọn: endpoint tương thích OpenAI
OPENAI_BASE_URL=
