# Copy file này thành backend/.env rồi điền key. KHÔNG commit file .env.
# Chỉ gửi dữ liệu TỰ SINH lên API bên ngoài — không dùng chat thật của tổ chức.
# Đổi endpoint thì đổi key CÙNG LÚC (key của endpoint cũ sẽ bị gửi tới endpoint mới). Chạy `python -m detect.llm probe` sau khi đổi.

# --- OpenAI (model tham chiếu v6 = gpt-4o-mini) ---
OPENAI_API_KEY=
EXTRACT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Endpoint tương thích OpenAI khác, vd. DeepSeek qua River ---
# OPENAI_API_KEY=<key River>
# OPENAI_BASE_URL=https://api.river.ai/v1
# EXTRACT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# RESPONSE_FORMAT=json_object        # nếu probe báo endpoint không nhận json_schema strict
# EMBED_MODEL=none                   # nếu endpoint không có embedding (task chỉ xếp theo độ mới)
# EMBED_BASE_URL=                    # hoặc lấy embedding ở endpoint khác
# EMBED_API_KEY=
